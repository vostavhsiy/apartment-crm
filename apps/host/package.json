{
  "name": "@apartment-crm/host",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "next": "~15.2.4",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "nx": {
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "next dev --turbopack"
          ],
          "parallel": false,
          "cwd": "apps/host"
        }
      }
    }
  },
  "devDependencies": {
    "@types/lodash.throttle": "^4.1.9",
    "sass": "^1.90.0"
  }
}
