model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
  name      String?
  phone     String?
  avatarUrl String?
  role      Role    @default(USER)

  apartments  Apartment[]
  collections Collection[]
  clients     Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
