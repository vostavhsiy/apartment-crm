model Collection {
  id          String  @id @default(cuid())
  title       String
  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  apartmentsLinks ApartmentCollection[]
  clientsLinks    CollectionClient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collections")
}
