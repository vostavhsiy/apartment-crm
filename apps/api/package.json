{
  "name": "@apartment-crm/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@apartment-crm/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@apartment-crm/api:build:development"
          },
          "production": {
            "buildTarget": "@apartment-crm/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true,
          "testNamePattern": "ApartmentsService"
        }
      },
      "docker-build": {
        "dependsOn": [
          "build"
        ],
        "command": "docker build -f apps/api/Dockerfile . -t apartment-crm-api"
      },
      "dev": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "nest start --watch"
          ],
          "parallel": false,
          "cwd": "apps/api"
        }
      },
      "migrate": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "npx prisma generate",
            "npx prisma migrate deploy"
          ],
          "parallel": false,
          "cwd": "apps/api"
        }
      },
      "migrate-dev": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "npx prisma migrate dev"
          ],
          "parallel": false,
          "cwd": "apps/api"
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.13.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "nodemailer": "^7.0.5"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/bcrypt": "^6.0.0",
    "@types/nodemailer": "^6.4.17"
  }
}
