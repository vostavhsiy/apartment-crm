{
  "name": "@apartment-crm/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@apartment-crm/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@apartment-crm/api:build:development"
          },
          "production": {
            "buildTarget": "@apartment-crm/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker-build": {
        "dependsOn": [
          "build"
        ],
        "command": "docker build -f apps/api/Dockerfile . -t apartment-crm-api"
      },
      
      "migrate": {
        "executor": "nx:run-commands",
        "options": {
          "commands": ["npx prisma generate", "npx prisma migrate deploy"],
          "parallel": false,
          "cwd": "apps/api"
        }
      }
    }
  },
  "dependencies": {
    "@prisma/client": "^6.13.0"
  }
}
